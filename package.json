{
  "name": "unplugin-images-cls-optimizer",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@10.34.5",
  "description": "Erase CLS by automatically optimizing images.",
  "author": "Estéban Soubiran <esteban@soubiran.dev>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/Barbapapazes",
  "homepage": "https://github.com/Barbapapazes/unplugin-images-cls-optimizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Barbapapazes/unplugin-images-cls-optimizer"
  },
  "bugs": "https://github.com/Barbapapazes/unplugin-images-cls-optimizer/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    },
    "./*": "./*"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "build": "tsdown",
    "prepack": "pnpm run build",
    "release": "bumpp --sign"
  },
  "dependencies": {
    "@unpic/pixels": "^1.3.0",
    "@unpic/placeholder": "^0.1.2",
    "blurhash": "^2.0.5",
    "magic-string": "^0.30.21",
    "unplugin": "^2.3.11"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "bumpp": "^10.4.1",
    "eslint": "^9.39.5",
    "taze": "^19.17.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.3.1"
    }
  }
}
